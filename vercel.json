{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/learn",
      "destination": "/work-with-me#learn",
      "permanent": false
    },
    {
      "source": "/in-you",
      "destination": "/music",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(admin|content|studio|invoice)(\\.html)?",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}
